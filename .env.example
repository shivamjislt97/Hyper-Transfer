# ─── Copy this file to .env and fill in your values ───────────
# cp .env.example .env

# Your Telegram bot token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram user IDs allowed to use the bot
# Leave empty to allow everyone (NOT recommended for production)
ALLOWED_USER_IDS=123456789,987654321

# Google Drive folder name where files will be uploaded
GDRIVE_FOLDER=mega_transfers

# rclone remote name (must match [remote_name] in rclone.conf)
RCLONE_REMOTE_NAME=gdrive

# Local download workspace path
WORKSPACE_PATH=/teamspace/studios/this_studio/downloads

# Maximum workspace size in GB
MAX_WORKSPACE_GB=198

# Path to MegaBasterd JAR (for quota fallback)
MEGABASTERD_JAR_PATH=/opt/megabasterd/MegaBasterd.jar

# Progress bar update interval in seconds
PROGRESS_UPDATE_INTERVAL=2
